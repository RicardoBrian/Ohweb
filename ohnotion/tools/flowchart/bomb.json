{
  "id": "bomb_flow",
  "langs": ["ko"],
  "title": {"ko": "폭탄 돌리기 앱 순서도 (전체 코드)"},
  "legend": {
    "term": {"ko": "시작 · 끝 · 이벤트 시작"},
    "proc": {"ko": "값 정하기 · 속성 바꾸기"},
    "io": {"ko": "화면 · 소리 · 진동"}
  },
  "note": {"ko": "상자 안 굵은 글씨는 앱인벤터 블록 그대로, 아래 회색 글씨는 설명이다. 글자 색은 그 블록을 꺼내는 서랍 색이다. 점선 상자는 그 안의 블록들이 어느 이벤트 블록 안에 들어가는지를 뜻한다."},
  "charts": [
    {
      "title": {"ko": "① 시작 버튼을 눌렀을 때"},
      "group": {"ko": "언제 시작.클릭했을때 · 실행"},
      "steps": [
        {"type": "terminal", "lines": [[["ai.ctrl", "언제 시작.클릭했을때"]]], "desc": "시작 버튼을 누르면 여기서 시작"},
        {"type": "process", "lines": [
          [["ai.set", "지정하기 시계1.타이머간격"], "값 ←"],
          [["ai.math", "임의의 정수"], ["ai.math", "시작"], ["ai.math", "3000"], ["ai.math", "끝"], ["ai.math", "10000"]]
        ], "desc": "3~10초 중 아무 때나 (1000밀리초 = 1초)"},
        {"type": "process", "lines": [[["ai.set", "지정하기 시계1.타이머활성화여부"], "값 ←", ["ai.logic", "참"]]], "desc": "시계 켜기 = 초 세기 시작"},
        {"type": "io", "lines": [[["ai.set", "지정하기 폭탄사진.배경이미지"], "값 ←", ["ai.text", "\"bomb.png\""]]], "desc": "폭탄 그림으로 (다시 할 때도 원래대로)"},
        {"type": "io", "lines": [[["ai.set", "지정하기 레이블1.텍스트"], "값 ←", ["ai.text", "\"째깍째깍...\""]]], "desc": "화면에 \"째깍째깍\" 표시"},
        {"type": "io", "lines": [[["ai.set", "지정하기 Screen1.배경색"], "값 ←", ["ai.color", "노랑"]]], "desc": "화면을 노랗게"},
        {"type": "io", "lines": [[["ai.call", "호출 플레이어1.시작하기"]]], "desc": "째깍째깍 소리 시작 (반복 재생)"},
        {"type": "process", "lines": [[["ai.set", "지정하기 시작.보이기여부"], "값 ←", ["ai.logic", "거짓"]]], "desc": "시작 버튼 숨기기"},
        {"type": "terminal", "lines": ["끝"], "desc": "폰을 옆 친구에게 넘긴다"}
      ]
    },
    {
      "title": {"ko": "② 타이머가 작동할 때 (폭탄이 터질 때)"},
      "group": {"ko": "언제 시계1.타이머가작동할때 · 실행"},
      "steps": [
        {"type": "terminal", "w": 300, "lines": [[["ai.ctrl", "언제 시계1.타이머가작동할때"]]], "desc": "정해 둔 시간이 지나면 여기서 시작"},
        {"type": "process", "lines": [[["ai.set", "지정하기 시계1.타이머활성화여부"], "값 ←", ["ai.logic", "거짓"]]], "desc": "시계 끄기 (안 끄면 또 터진다)"},
        {"type": "io", "lines": [[["ai.call", "호출 플레이어1.정지"]]], "desc": "째깍째깍 소리 멈추기"},
        {"type": "io", "lines": [[["ai.set", "지정하기 폭탄사진.배경이미지"], "값 ←", ["ai.text", "\"boom.jpg\""]]], "desc": "폭발 그림으로 바꾸기"},
        {"type": "io", "lines": [[["ai.set", "지정하기 레이블1.텍스트"], "값 ←", ["ai.text", "\"펑!\""]]], "desc": "화면에 \"펑!\" 표시"},
        {"type": "io", "lines": [[["ai.set", "지정하기 Screen1.배경색"], "값 ←", ["ai.color", "빨강"]]], "desc": "화면을 빨갛게"},
        {"type": "io", "lines": [[["ai.call", "호출 소리1.재생하기"]]], "desc": "폭발음 재생"},
        {"type": "io", "lines": [[["ai.call", "호출 소리1.진동하기"], ["ai.call", "밀리초"], ["ai.math", "1000"]]], "desc": "1초 동안 진동"},
        {"type": "process", "lines": [[["ai.set", "지정하기 시작.보이기여부"], "값 ←", ["ai.logic", "참"]]], "desc": "시작 버튼 다시 보이기"},
        {"type": "terminal", "lines": ["끝"], "desc": "폭탄을 들고 있던 사람이 걸림"}
      ]
    }
  ]
}
