# AI 실험실: 고친 파일이 바로 보이게 매번 서버에 바뀌었는지 묻는다(바뀌지 않았으면 304라 빠르다).
/ai*
  Cache-Control: no-cache

# 디자인 파일(theme.css 등)·스크립트·페이지도 매번 바뀌었는지 확인한다 — 배포해도 예전 화면이 남는 걸 막는다.
/*.css
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache

# 새 플랫폼 공통 파일(render.js·logo.js·kaka.css): 선생님 화면(admin.kakainfo.com)이 모듈로 불러온다.
/kaka/*
  Access-Control-Allow-Origin: https://admin.kakainfo.com
  Vary: Origin
