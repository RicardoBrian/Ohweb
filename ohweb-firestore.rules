rules_version = '2';

/**
 * ohweb-93062 Firestore 규칙 — ohweb(admin.kakainfo.com), ohinfo
 * (info.kakainfo.com/kakainfo.com), ohshrt(short.kakainfo.com)가 이
 * 프로젝트를 같이 쓴다.
 *
 * 이 파일은 Firebase 콘솔의 Rules 탭에 수동으로 붙여넣어 배포한다(이
 * 레포에 Firebase CLI 배포 설정이 없어서 자동 배포되지 않음 — seatchange의
 * firebase.json/firestore.rules와 달리 참고용 기록일 뿐이다).
 *
 * 학생 쪽(ohinfo)엔 아직 진짜 인증이 없다(localStorage 기반 자체 세션뿐).
 * 그래서 학생이 직접 쓰는 컬렉션(students/posts/qna_threads/student_forms/
 * student_form_responses/exam_progress/exam_results)은 지금 완전히 잠글 수
 * 없다 — 잠그면 회원가입/게시글 작성/시험 응시가 그대로 깨진다. 학생 인증을
 * 붙이는 다음 단계(Phase 2)에서 이 컬렉션들도 손봐야 한다.
 *
 * 지금 당장 잠근 건 "학생 쪽에서 쓰기 경로가 아예 없는" 컬렉션들 —
 * schools/classes/exams/exam_questions/exam_assignments/appSettings.
 * 이전엔 이 프로젝트 전체가 `allow read, write: if true`였다.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'qjatjr7575@gmail.com';
    }

    // 학생 쪽에서 건드릴 일이 아예 없는 것들 — 관리자만
    match /schools/{id}          { allow read, write: if isAdmin(); }
    match /classes/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /exams/{id}            { allow read: if true; allow write: if isAdmin(); }
    match /exam_questions/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /exam_assignments/{id} { allow read: if true; allow write: if isAdmin(); }
    match /appSettings/{id}      { allow read: if true; allow write: if isAdmin(); }

    // ohshrt — 단축 URL. get(단축코드로 직접 열기)은 누구나(리다이렉트가
    // 그렇게 동작해야 하므로, functions/[[code]].js가 인증 없이 REST로 읽음).
    // 목록 조회·생성·삭제는 관리자만.
    function validShortLink() {
      let d = request.resource.data;
      return d.keys().hasAll(['url', 'createdAt']) && d.keys().hasOnly(['url', 'createdAt'])
          && d.url is string && d.url.size() <= 2000;
    }
    match /short_links/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validShortLink();
      allow delete: if isAdmin();
    }

    // 학생이 직접 쓰는 데이터 — 학생 인증(Phase 2) 전까지는 기존과 동일하게 열어둠.
    // 단, 로그인 5회 실패 잠금(failedAttempts/locked)만은 예외 — 학생 계정
    // 자체가 Firestore write 권한을 열어두고 있어서, 이 필드까지 그대로
    // 열어두면 학생(또는 봇)이 스스로 잠금을 풀어버릴 수 있다. 그래서:
    //   - 관리자(isAdmin)는 언제나 전부 가능 — admin.html의 잠금 해제 버튼.
    //   - 로그인에 "성공해서" 그 학생 본인으로 인증된 상태(student-auth.js의
    //     emailFor(id) 계정)면 자기 실패 카운트를 0으로 리셋하는 것도 가능.
    //   - 그 외(=아직 로그인 전, 비밀번호를 틀려서 카운트를 올리는 그 순간)는
    //     failedAttempts/locked/lockedAt 필드만 건드릴 수 있고, failedAttempts를
    //     낮추거나 locked를 true→false로 되돌리는 건 막는다 — recordFailedLogin
    //     (student-auth.js)이 늘리기만/잠그기만 하도록 쓰여 있는 것과 대응.
    function isOwnStudentAuth(id) {
      return request.auth != null && request.auth.token.email == id + '@ohinfo.local';
    }
    function lockFieldsOnlyAndNotLoosened() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['failedAttempts', 'locked', 'lockedAt'])
        && after.get('failedAttempts', 0) >= before.get('failedAttempts', 0)
        && (before.get('locked', false) == false || after.get('locked', false) == true);
    }
    match /students/{id} {
      allow read, create, delete: if true;
      allow update: if isAdmin() || isOwnStudentAuth(id) || lockFieldsOnlyAndNotLoosened();
    }
    match /posts/{id}                  { allow read, write: if true; }
    // 댓글(posts/{id}/comments/{commentId})도 posts 규칙이 자동으로 상속하지
    // 않는다 — qna_threads/messages와 같은 이유로 별도로 열어야 한다.
    match /posts/{id}/{document=**}    { allow read, write: if true; }
    // qna_threads 자체 문서뿐 아니라 실제 질문/답변이 쓰이는 하위 컬렉션
    // (qna_threads/{학생ID}/messages/{msgId})까지 열어야 한다 — 규칙은
    // 하위 컬렉션에 자동으로 상속되지 않아서, 이걸 빠뜨리면 스레드 문서는
    // 되는데 정작 메시지 전송(addDoc)은 기본 거부에 걸려 permission-denied가 난다.
    match /qna_threads/{id}            { allow read, write: if true; }
    match /qna_threads/{id}/{document=**} { allow read, write: if true; }
    match /student_forms/{id}          { allow read, write: if true; }
    match /student_form_responses/{id} { allow read, write: if true; }
    match /exam_progress/{id}          { allow read, write: if true; }
    match /exam_results/{id}           { allow read, write: if true; }

    // 명시 안 한 나머지 컬렉션은 전부 거부(기본값)
  }
}
