rules_version = '2';

/**
 * ohweb-93062 Firestore 규칙 — ohweb(admin.kakainfo.com), ohinfo
 * (info.kakainfo.com/kakainfo.com), ohshrt(short.kakainfo.com)가 이
 * 프로젝트를 같이 쓴다.
 *
 * 이 파일은 Firebase 콘솔의 Rules 탭에 수동으로 붙여넣어 배포한다(이
 * 레포에 Firebase CLI 배포 설정이 없어서 자동 배포되지 않음 — seatchange의
 * firebase.json/firestore.rules와 달리 참고용 기록일 뿐이다).
 *
 * 학생은 이제 Firebase Auth로 로그인한다(student-auth.js) — 합성 이메일
 * {문서ID}@ohinfo.local. 그래서 isOwnStudentAuth()로 "본인"을 규칙에서
 * 판별할 수 있고, 시험 관련 컬렉션은 그 기준으로 잠갔다.
 *
 * 본인만 보는 데이터(1:1 질문, 시험 진행 기록·결과)는 Auth 기준으로 잠갔다.
 * 학생 페이지는 이런 데이터를 읽기 전에 session.js의 authReady()로 로그인
 * 복원을 기다린다.
 *
 * 아직 열려 있는 것: students 읽기(로그인 화면이 비로그인 상태에서 명단을
 * 받아 쓰는 구조라서 — 공개용 최소 명단 분리 작업과 같이 가야 한다),
 * posts, student_forms, student_form_responses.
 *
 * 이전엔 이 프로젝트 전체가 `allow read, write: if true`였다.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // email_verified까지 본다 — 이메일/비밀번호 가입이 켜져 있어서(학생 로그인용),
    // 검증 안 된 계정이 관리자 이메일을 주장하는 경우를 막는다. 관리자는 Google
    // 로그인이라 항상 verified다.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'qjatjr7575@gmail.com'
          && request.auth.token.email_verified == true;
    }

    // 학생 쪽에서 건드릴 일이 아예 없는 것들 — 관리자만
    match /schools/{id}          { allow read, write: if isAdmin(); }
    match /classes/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /exams/{id}            { allow read: if true; allow write: if isAdmin(); }
    // 문항 본문은 학생이 읽어야 화면에 뜬다. 정답은 여기 없고 exam_answers에
    // 따로 있으므로 공개 읽기로 둬도 새어나갈 게 없다.
    match /exam_questions/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /exam_assignments/{id} { allow read: if true; allow write: if isAdmin(); }
    match /appSettings/{id}      { allow read: if true; allow write: if isAdmin(); }

    // ohshrt — 단축 URL. get(단축코드로 직접 열기)은 누구나(리다이렉트가
    // 그렇게 동작해야 하므로, functions/[[code]].js가 인증 없이 REST로 읽음).
    // 목록 조회·생성·삭제는 관리자만.
    function validShortLink() {
      let d = request.resource.data;
      return d.keys().hasAll(['url', 'createdAt']) && d.keys().hasOnly(['url', 'createdAt'])
          && d.url is string && d.url.size() <= 2000;
    }
    match /short_links/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validShortLink();
      allow delete: if isAdmin();
    }

    // 학생이 직접 쓰는 데이터 — 학생 인증(Phase 2) 전까지는 기존과 동일하게 열어둠.
    // 단, 로그인 5회 실패 잠금(failedAttempts/locked)만은 예외 — 학생 계정
    // 자체가 Firestore write 권한을 열어두고 있어서, 이 필드까지 그대로
    // 열어두면 학생(또는 봇)이 스스로 잠금을 풀어버릴 수 있다. 그래서:
    //   - 관리자(isAdmin)는 언제나 전부 가능 — admin.html의 잠금 해제 버튼.
    //   - 로그인에 "성공해서" 그 학생 본인으로 인증된 상태(student-auth.js의
    //     emailFor(id) 계정)면 자기 실패 카운트를 0으로 리셋하는 것도 가능.
    //   - 그 외(=아직 로그인 전, 비밀번호를 틀려서 카운트를 올리는 그 순간)는
    //     failedAttempts/locked/lockedAt 필드만 건드릴 수 있고, failedAttempts를
    //     낮추거나 locked를 true→false로 되돌리는 건 막는다 — recordFailedLogin
    //     (student-auth.js)이 늘리기만/잠그기만 하도록 쓰여 있는 것과 대응.
    // Firebase Auth는 이메일을 소문자로 정규화해서 저장하는데 Firestore 문서
    // ID는 대소문자를 구분한다(자동 생성 ID엔 대문자가 섞여 있다). 그래서
    // 단순 비교를 쓰면 대문자가 든 ID에서는 이 함수가 항상 false가 되고,
    // 결과적으로 "본인 확인" 분기 전체가 죽어 있었다 — 로그인 성공 후
    // failedAttempts를 0으로 되돌리는 쓰기가 막혀서, 비밀번호를 한 번이라도
    // 틀린 학생은 그 뒤로 올바른 비밀번호로도 로그인이 안 되는 버그로 이어졌다.
    function isOwnStudentAuth(id) {
      return request.auth != null
          && request.auth.token.email.lower() == (id + '@ohinfo.local').lower();
    }
    function lockFieldsOnlyAndNotLoosened() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['failedAttempts', 'locked', 'lockedAt'])
        && after.get('failedAttempts', 0) >= before.get('failedAttempts', 0)
        && (before.get('locked', false) == false || after.get('locked', false) == true);
    }
    // 본인이 자기 문서에서 바꿀 수 있는 것 — 학생 쪽 코드가 실제로 쓰는 것만:
    //   photoUrl(마이페이지·가입), registered(가입 시 true로만), failedAttempts
    //   (로그인 성공 시 0으로만), password(옛 평문 필드 삭제만).
    // 예전엔 본인이면 아무 필드나 바꿀 수 있어서, 학생이 콘솔에서 자기 문서에
    // isMaster:true를 넣으면 교사(마스터) 권한이 생겼다.
    function ownSafeUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return changed.hasOnly(['photoUrl', 'registered', 'failedAttempts', 'password'])
        && (!changed.hasAny(['registered']) || after.registered == true)
        && (!changed.hasAny(['failedAttempts']) || after.failedAttempts == 0)
        && (!changed.hasAny(['password']) || !('password' in after))
        && (!changed.hasAny(['photoUrl']) || (after.photoUrl is string && after.photoUrl.size() < 400000));
    }
    match /students/{id} {
      // 생성·삭제는 관리자만 — 예전엔 누구나 학생 문서를 만들 수 있어서
      // isMaster:true인 가짜 학생을 만들고 그 계정으로 가입할 수 있었다.
      // 학생 쪽 코드에는 생성·삭제 경로가 없다(가입은 관리자가 만든 문서를 update).
      //
      // 읽기: 로그인 화면은 이제 공개용 명단(student_directory)을 읽는다. 전환 순서 —
      //   1단계) 이 규칙 그대로 적용 → admin 학생 화면을 한 번 열어 명단 자동 생성
      //          + "평문 비밀번호 정리" 실행
      //   2단계) 아래 줄을 `allow read: if isAdmin() || isOwnStudentAuth(id);`로 바꿔 적용
      //          (이름·사진·옛 비밀번호가 더 이상 공개되지 않는다)
      allow read: if true; // PHASE2: allow read: if isAdmin() || isOwnStudentAuth(id);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isOwnStudentAuth(id) && ownSafeUpdate()) || lockFieldsOnlyAndNotLoosened();
    }
    // 공개용 학생 명단 — 로그인 화면용 최소 정보(학교/학년/반/번호/가입·잠금 상태).
    // 이름·사진·비밀번호는 없다. 문서 ID = 학생 문서 ID. 쓰기는 admin이 students를
    // 기준으로 맞추고, 로그인 화면은 실패 카운트·잠금(늘리기만)과, 본인 인증 뒤
    // 가입 표시(true로만)·실패 카운트 리셋(0으로만)만 한다.
    function dirOwnUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['registered', 'failedAttempts'])
        && (!changed.hasAny(['registered']) || request.resource.data.registered == true)
        && (!changed.hasAny(['failedAttempts']) || request.resource.data.failedAttempts == 0);
    }
    match /student_directory/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isOwnStudentAuth(id) && dirOwnUpdate()) || lockFieldsOnlyAndNotLoosened();
    }
    // 게시판(ohdlet). 예전엔 완전 개방이라 누구나 남의 글을 고치거나 지울 수 있었다.
    //  - 읽기: 로그인한 사용자(학생 페이지는 로그인 복원 뒤 읽는다)
    //  - 작성: 본인 studentId로만
    //  - 수정: 작성자 본인(내용·삭제표시) / 누구나 좋아요·댓글 수 ±1만 /
    //          마스터 학생 고정(pinnedBy의 students 문서 isMaster 확인) / 관리자(번역 등)
    //  - 실제 삭제: 관리자만(앱은 deleted 표시로 지운다)
    function counterStep(field) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([field, 'updatedAt'])
        && request.resource.data[field] is number
        && (request.resource.data[field] - resource.data.get(field, 0)) in [1, -1];
    }
    function masterPin() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let by = request.resource.data.get('pinnedBy', '');
      return changed.hasOnly(['pinned', 'pinnedBy', 'updatedAt'])
        && by is string && by.size() > 0
        && isOwnStudentAuth(by)
        && get(/databases/$(database)/documents/students/$(by)).data.get('isMaster', false) == true;
    }
    match /posts/{id} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || isOwnStudentAuth(request.resource.data.get('studentId', ''));
      allow update: if isAdmin()
          || (isOwnStudentAuth(resource.data.get('studentId', ''))
              && request.resource.data.get('studentId', '') == resource.data.get('studentId', ''))
          || (request.auth != null && (counterStep('likes') || counterStep('commentCount')))
          || masterPin();
      allow delete: if isAdmin();
    }
    // 댓글(posts/{id}/comments/{commentId}) — 본인 이름으로만 달고, 본인·관리자만 지운다.
    match /posts/{postId}/comments/{cid} {
      allow read: if request.auth != null;
      allow create: if isOwnStudentAuth(request.resource.data.get('studentId', ''));
      allow update: if isAdmin();
      allow delete: if isAdmin() || isOwnStudentAuth(resource.data.get('studentId', ''));
    }
    // qna_threads 자체 문서뿐 아니라 실제 질문/답변이 쓰이는 하위 컬렉션
    // (qna_threads/{학생ID}/messages/{msgId})까지 열어야 한다 — 규칙은
    // 하위 컬렉션에 자동으로 상속되지 않아서, 이걸 빠뜨리면 스레드 문서는
    // 되는데 정작 메시지 전송(addDoc)은 기본 거부에 걸려 permission-denied가 난다.
    // 1:1 질문은 스레드 ID = 학생 문서 ID. 본인과 관리자만 — 예전엔 누구나
    // 모든 학생의 상담 내용을 읽고 쓸 수 있었다.
    match /qna_threads/{id}            { allow read, write: if isAdmin() || isOwnStudentAuth(id); }
    match /qna_threads/{id}/{document=**} { allow read, write: if isAdmin() || isOwnStudentAuth(id); }
    // 학생 설문(formlab에서 만들고 formfill로 응답). 설문 자체는 링크로 누구나
    // 열어야 하므로 공개 읽기. 수정·삭제는 만든 학생(ownerId)과 관리자만 — 단,
    // 응답 수(responseCount)는 응답자가 올린다(±1만).
    function onlyResponseCountStep() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['responseCount'])
        && request.resource.data.responseCount is number
        && (request.resource.data.responseCount - resource.data.get('responseCount', 0)) in [1, -1];
    }
    match /student_forms/{id} {
      allow read: if true;
      allow create: if isAdmin() || isOwnStudentAuth(request.resource.data.get('ownerId', ''));
      allow update: if isAdmin()
          || (isOwnStudentAuth(resource.data.get('ownerId', ''))
              && request.resource.data.get('ownerId', '') == resource.data.get('ownerId', ''))
          || onlyResponseCountStep();
      allow delete: if isAdmin() || isOwnStudentAuth(resource.data.get('ownerId', ''));
    }
    // 응답: 설문 만든 학생·응답한 본인·관리자만 읽는다 — 예전엔 누구나 모든
    // 설문의 응답(이름·답변·첨부)을 읽을 수 있었다. 응답은 비로그인 허용 설문이면
    // 'anonymous'로, 아니면 로그인한 본인 ID로만 낼 수 있다.
    match /student_form_responses/{id} {
      allow read: if isAdmin()
          || isOwnStudentAuth(resource.data.get('ownerId', ''))
          || isOwnStudentAuth(resource.data.get('respondentId', ''));
      allow create: if request.resource.data.get('respondentId', '') == 'anonymous'
          || isOwnStudentAuth(request.resource.data.get('respondentId', ''));
      allow update: if isAdmin();
      allow delete: if isAdmin() || isOwnStudentAuth(resource.data.get('ownerId', ''));
    }
    // ── 시험 ──
    // 채점은 ohinfo의 /api/grade-exam이 서비스 계정으로 한다. 서비스 계정은
    // 보안 규칙을 우회하므로, 아래에서 학생의 점수 쓰기를 완전히 막아도
    // 정상 채점은 그대로 동작한다.

    // 진행 상황: 학생은 시작 시각·탭 이탈 횟수까지만 쓸 수 있고, 점수와
    // "제출됨" 상태는 못 건드린다. 한 번 제출된 뒤에는 학생 쓰기를 전부 막아
    // 재응시로 되돌리는 것도 차단한다.
    // 문서 ID는 `${asId}_${학생문서ID}` — 끝 부분이 학생 ID다. 문서가 아직 없을 때
    // (첫 입장 전)도 판별할 수 있도록 데이터가 아니라 ID로 본인을 가린다.
    // 예전엔 읽기가 완전 공개라 누구나 전교생의 이름·점수를 볼 수 있었다.
    function progOwner(id) {
      let parts = id.split('_');
      return parts[parts.size() - 1];
    }
    match /exam_progress/{id} {
      allow read: if isAdmin() || isOwnStudentAuth(progOwner(id));
      allow create: if isAdmin()
          || (isOwnStudentAuth(progOwner(id))
              && request.resource.data.get('studentId', progOwner(id)) == progOwner(id)
              && !request.resource.data.keys().hasAny(['totalScore', 'totalPoints'])
              && request.resource.data.get('status', '') != 'submitted');
      allow update: if isAdmin()
          || (isOwnStudentAuth(progOwner(id))
              && resource.data.get('status', '') != 'submitted'
              && request.resource.data.get('status', '') != 'submitted'
              && request.resource.data.get('studentId', '') == resource.data.get('studentId', '')
              && request.resource.data.get('totalScore', -1) == resource.data.get('totalScore', -1)
              && request.resource.data.get('totalPoints', -1) == resource.data.get('totalPoints', -1));
    }

    // 채점 결과: 쓰기는 서버/관리자만(예전엔 학생이 자기 점수를 임의로
    // 써넣을 수 있었다). 읽기는 본인 것과 관리자만 — exam.html의 결과 조회는
    // studentId로 필터링하므로 이 규칙으로 통과한다.
    match /exam_results/{id} {
      allow read: if isAdmin() || isOwnStudentAuth(resource.data.get('studentId', ''));
      allow write: if isAdmin();
    }

    // 정답·테스트케이스. 학생은 절대 읽으면 안 된다 — 이게 exam_questions
    // 안에 같이 들어있던 탓에, 공개 읽기 규칙을 타고 시험 전에 정답이
    // 전부 노출됐다.
    match /exam_answers/{id}           { allow read, write: if isAdmin(); }

    // 명시 안 한 나머지 컬렉션은 전부 거부(기본값)
  }
}
