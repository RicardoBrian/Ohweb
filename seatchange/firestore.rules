rules_version = '2';

/**
 * SeatChange Firestore 규칙
 *
 * 이 앱은 로그인 화면이 없다. 대신 익명 인증(Anonymous Auth)을 써서
 * 브라우저마다 uid를 하나 받고, 그 uid를 좌석표의 소유자로 기록한다.
 * 사용자는 로그인을 의식하지 못하지만 규칙은 소유자를 판별할 수 있다.
 *
 * 읽기는 두 가지로 나뉜다. 문서 ID로 직접 여는 것(get)은 링크를 아는
 * 사람이면 누구나 — 공유 링크가 그렇게 동작해야 하므로. 반면 목록으로
 * 훑어보는 것(list, "내 좌석표 불러오기")은 소유자 본인만 — 안 그러면
 * 이 프로젝트의 firebaseConfig(공개 정보)만 알아도 아무나 전체 좌석표
 * 목록을 긁어갈 수 있다.
 * 쓰기는 만든 사람만 가능하다.
 *
 * 테스트 모드(`request.time < timestamp.date(...)`)는 절대 쓰지 않는다.
 * 그 규칙은 날짜가 지나면 조건이 거짓이 되어 전부 거부로 뒤집힌다.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /**
     * 형태 검증. 남의 Firestore를 공짜 저장소로 쓰지 못하게 막는 것이 주 목적이다.
     * 읽기가 열려 있는 만큼 쓰기 쪽 상한을 확실히 걸어둔다.
     *
     * 숫자는 `is int`가 아니라 `is number`로 본다 — JS에서 온 값이 정수로
     * 직렬화될지 실수로 될지에 규칙이 좌우되면 안 되기 때문.
     */
    function validRoom() {
      let d = request.resource.data;
      return d.keys().hasAll(['ownerUid', 'name', 'desks', 'members', 'updatedAt'])
          && d.keys().hasOnly([
               'ownerUid', 'name', 'desks', 'members', 'rowAssign', 'avoidPairs',
               'avoidPrevSeat', 'avoidPrevMate', 'prev', 'result', 'createdAt', 'updatedAt'
             ])
          && d.ownerUid is string
          && d.name is string && d.name.size() <= 60
          && d.desks is list && d.desks.size() <= 80
          && d.members is list && d.members.size() <= 80
          && d.updatedAt == request.time;   // 클라이언트가 시각을 위조하지 못하게
    }

    match /seat_rooms/{roomId} {

      // 링크를 아는 사람은 누구나 볼 수 있다. 문서 ID가 사실상 비밀번호
      // 역할을 하므로 추측하기 어려운 자동 ID(addDoc)를 쓴다.
      allow get: if true;

      // 목록 조회는 소유자 것만. 쿼리 자체가 ownerUid로 좁혀져 있어야
      // 통과한다 — list 규칙은 "이 쿼리가 반환할 수 있는 모든 문서가
      // 조건을 만족하는가"를 정적으로 판단하므로, where('ownerUid','==',uid)
      // 없이 컬렉션 전체를 훑으려는 쿼리는 이 조건을 증명할 수 없어 그냥
      // 거부된다 — 서버가 결과를 가져온 뒤 걸러내는 게 아니다.
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;

      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && validRoom();

      // 소유자만 수정할 수 있고, 소유자 자체는 바꿀 수 없다.
      allow update: if signedIn()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && validRoom();

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // 위에 명시하지 않은 모든 경로는 거부된다(rules_version 2의 기본값).
    // 새 컬렉션을 추가하면 여기에 규칙을 같이 써야 동작한다.
  }
}
